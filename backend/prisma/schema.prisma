// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

// RBAC roles used inside a project
enum Role {
  admin
  tester
  viewer
}

// HTTP methods supported for endpoints / test cases
enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

// Lifecycle of a test run. TestSuite IS the run record, so this tracks the
// async job from creation through completion.
enum SuiteStatus {
  pending
  running
  completed
  failed
}

// "generated" suites are driven by the AI/MARL engine against the current
// spec. "replay" suites resend a fixed, previously-captured request sequence
// (see TestSuite.originSuiteId) — no engine-service involvement at all.
enum TestRunType {
  generated
  replay
}

// Lifecycle of a codebase-to-OpenAPI generation job. Mirrors SuiteStatus:
// both track an async job running in the Python engine-service.
enum SpecGenStatus {
  pending
  running
  completed
  failed
}

// Lifecycle of a standalone dependency-graph build. Same four states as the
// other engine-service jobs; `ready` rather than `completed` because the row
// outlives the job — it goes on holding the graph long after the build ended.
enum GraphStatus {
  pending
  running
  ready
  failed
}

// Lifecycle of an email invitation to join a project.
enum InvitationStatus {
  pending
  accepted
  declined
  expired
}

// What a single-use AuthToken row is for.
//
// `email_verification` is no longer issued: verification moved into the signup
// flow, and a PendingSignup carries its own code. The variant stays because
// dropping a value from a Postgres enum is a table rewrite, and an unused one
// costs nothing.
enum AuthTokenType {
  email_verification
  password_reset
}

// The three independent places the platform calls an LLM. Kept separate
// (rather than one row) because each already runs against a different
// provider/model in practice — OOPS spec-generation targets a cheaper model
// than test-generation, and the Reports explainer is a third, unrelated
// integration entirely. See LlmSettings.
enum LlmScope {
  TEST_ENGINE
  SPEC_GENERATION
  REPORT_EXPLANATION
}

// ----------------------------------------------------------------------------
// User model — owns credentials for the AutoRestTest platform
// ----------------------------------------------------------------------------
model User {
  id       String @id @default(uuid())
  // `username` doubles as a login identifier alongside `email`, which is why
  // it is immutable once chosen — see UsersService.updateProfile.
  username String @unique
  email    String @unique
  password String

  // Editable profile. `name` is a display name and falls back to `username`
  // everywhere in the UI; `avatarColor` is a key from AVATAR_COLORS (a palette
  // name, never a hex value) tinting the generated initial avatar.
  name        String?
  avatarColor String?

  // Null until the address is proven by a verification code. The gate is soft:
  // only project creation and sending invitations check it.
  emailVerifiedAt DateTime?

  // Set on every password change or reset. JwtStrategy rejects any token minted
  // before this instant, which is the app's only session-revocation mechanism —
  // without it a password reset would leave the attacker's JWT working.
  passwordChangedAt DateTime?

  // Opt-outs for the two transactional emails a user can receive repeatedly.
  notifyRunFinished Boolean @default(true)
  notifyInvitations Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Projects the user owns
  ownedProjects Project[] @relation("OwnedProjects")

  // Project memberships for collaboration
  projectMembers ProjectMember[]

  // Test runs the user has triggered
  triggeredSuites TestSuite[] @relation("TriggeredSuites")

  // Invitations this user has sent to others
  sentInvitations ProjectInvitation[] @relation("SentInvitations")

  // Email-verification codes and password-reset tokens
  authTokens AuthToken[]

  @@map("users")
}

// ----------------------------------------------------------------------------
// AuthToken — single-use secrets for email verification and password reset.
//
// Three deliberate differences from ProjectInvitation, the other token model:
//
//  1. `tokenHash` holds a sha256 of the secret, never the secret itself. An
//     invitation token is meant to be copied out of the UI; a reset token must
//     not survive a database leak.
//  2. The User relation cascades — the only one in this schema that does. These
//     rows are worthless without their user, and account deletion must not trip
//     over them.
//  3. `tokenHash` is indexed but NOT unique: a six-digit code hashes
//     deterministically, so two users can legitimately hold the same hash.
//     Reset tokens are found by hash; codes are found by (userId, type) and
//     only then hash-compared, which sidesteps the collision entirely.
// ----------------------------------------------------------------------------
model AuthToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String

  expiresAt  DateTime
  consumedAt DateTime?
  // Wrong-guess counter. A six-digit code is brute-forceable in 10^6 tries, so
  // this — not the expiry — is what actually protects it.
  attempts   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([tokenHash])
  @@map("auth_tokens")
}

// ----------------------------------------------------------------------------
// PendingSignup — a registration that has not proven its email address yet.
//
// The reason this table exists is account squatting. When registration wrote
// straight to `users`, signing up with an address you did not own claimed it
// permanently: `User.email` is unique, the row was never verified, and the real
// owner could never register. Parking the attempt here instead means an
// unproven address claims nothing at all.
//
// `email` is unique so a second attempt for the same address OVERWRITES the
// first rather than stacking beside it. That is the whole anti-squatting
// mechanism: a squatter's row is not a reservation, and whoever actually
// receives the code is the one who ends up with the account.
//
// `username` is deliberately NOT unique here — a pending signup reserves
// nothing. Uniqueness is checked against `users` on the way in (for a fast 409)
// and again inside the promote transaction, which is the authoritative check.
// ----------------------------------------------------------------------------
model PendingSignup {
  id       String @id @default(uuid())
  email    String @unique
  username String
  // Already bcrypt-hashed on arrival; the plaintext never reaches this table.
  password String
  // sha256, the same treatment AuthToken gives its secrets.
  codeHash String

  // Wrong-guess counter, and the reason a six-digit code is safe. Five misses
  // destroy the row; re-registering is the way back.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("pending_signups")
}

// ----------------------------------------------------------------------------
// LlmSettings model — every live-editable LLM setting (model, base URL, RPM
// limit, API key, ...) for one of the three LLM surfaces above, including the
// provider key. One row per scope, upserted from the admin settings page.
//
// A field left null means "no admin override — fall back to that surface's
// own environment default", not "use zero" or "use empty string". For
// TEST_ENGINE/SPEC_GENERATION that default lives in engine-service's own env
// (a separate process this one may not share a host with), so a null field is
// simply omitted from the request to engine-service rather than guessed at
// here. REPORT_EXPLANATION runs in this same process, so its null case
// resolves against this service's own env vars instead (see
// LlmSettingsService.getReportExplanationSettings).
// ----------------------------------------------------------------------------
model LlmSettings {
  id    String   @id @default(uuid())
  scope LlmScope @unique

  model               String?
  apiBase             String?
  rpmLimit            Int?
  // Only meaningful for TEST_ENGINE — the other two scopes never read them.
  maxTokens           Int?
  creativeTemperature Float?
  strictTemperature   Float?
  // Provider API key for this scope. Plain text, same as every other field
  // here — the DB itself (Neon) is the trust boundary for this deployment.
  apiKey              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("llm_settings")
}

// ----------------------------------------------------------------------------
// Project model — main workspace container in AutoRestTest.
// Everything else (API spec, endpoints, test suites, test cases) lives
// inside a project.
// ----------------------------------------------------------------------------
model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Ownership
  ownerId String
  owner   User   @relation("OwnedProjects", fields: [ownerId], references: [id])

  // Team collaboration
  members     ProjectMember[]
  invitations ProjectInvitation[]

  // Testing artifacts
  spec            ApiSpecification?
  specGeneration  SpecGeneration?
  dependencyGraph DependencyGraph?
  endpoints       Endpoint[]
  testSuites      TestSuite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("projects")
}

// ----------------------------------------------------------------------------
// ProjectMember model — links a User to a Project with a Role.
// Cascade-deletes with the parent project so cleanup is automatic.
// ----------------------------------------------------------------------------
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ----------------------------------------------------------------------------
// ProjectInvitation model — pending email invite to join a project.
// The invitee may not have an account yet, so the invite is keyed by email
// and carries a unique token used in the accept link. Becomes a
// ProjectMember once accepted.
// ----------------------------------------------------------------------------
model ProjectInvitation {
  id        String           @id @default(uuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  role      Role
  token     String           @unique
  status    InvitationStatus @default(pending)

  invitedById String
  invitedBy   User   @relation("SentInvitations", fields: [invitedById], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())

  // Only one outstanding invite per email per project.
  @@unique([projectId, email])
  @@index([email])
  @@map("project_invitations")
}

// ----------------------------------------------------------------------------
// ApiSpecification model — the OpenAPI 3.0 spec for a project (one per
// project). Raw YAML is stored as text; this is what gets handed to the
// testing engine. generatedByAI flags specs produced from source code.
// ----------------------------------------------------------------------------
model ApiSpecification {
  id            String   @id @default(uuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName      String
  fileContent   String // raw OAS 3.0 YAML
  generatedByAI Boolean  @default(false)
  uploadedAt    DateTime @default(now())

  @@map("api_specifications")
}

// ----------------------------------------------------------------------------
// SpecGeneration model — one in-flight or awaiting-review "generate an OpenAPI
// spec from an uploaded codebase" job, run by OOPS inside the engine-service.
//
// The generated document is parked in generatedSpec rather than written
// straight into ApiSpecification: the user reviews it first and explicitly
// applies it, so generation never silently replaces a project's spec or wipes
// its endpoints. One row per project, upserted on each attempt.
// ----------------------------------------------------------------------------
model SpecGeneration {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Engine-service job id, null until the job has been accepted.
  jobId  String?
  status SpecGenStatus @default(pending)

  sourceName String // uploaded archive filename

  // Progress, copied from the engine on each poll (9 pipeline steps).
  step      String?
  stepIndex Int     @default(0)
  stepTotal Int     @default(9)

  generatedSpec String? // the OAS JSON, held for review before it is applied
  warnings      String[]
  error         String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@map("spec_generations")
}

// ----------------------------------------------------------------------------
// DependencyGraph model — the project's Semantic Operation Dependency Graph,
// built from the spec alone (no test run, no LLM, no target API).
//
// Held here rather than on ApiSpecification so the heavy JSON stays out of that
// model's select projections, and so a build in flight has somewhere to record
// its status. Deleted when the spec is replaced: a graph derived from a spec
// that no longer exists is worse than no graph at all.
// ----------------------------------------------------------------------------
model DependencyGraph {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status GraphStatus @default(pending)
  jobId  String? // engine-service job id, null until accepted
  graph  Json? // the merged graph, in the frontend's wire shape
  error  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("dependency_graphs")
}

// ----------------------------------------------------------------------------
// Endpoint model — a single path+method extracted from the spec (or added
// manually). Stored so the UI can list detected endpoints, filter results,
// and support manual additions.
// ----------------------------------------------------------------------------
model Endpoint {
  id            String     @id @default(uuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path          String // e.g. /users/{id}
  method        HttpMethod
  description   String?
  addedManually Boolean    @default(false)
  createdAt     DateTime   @default(now())

  testCases   TestCase[]
  requestLogs RequestLog[]

  @@unique([projectId, method, path])
  @@index([projectId])
  @@map("endpoints")
}

// ----------------------------------------------------------------------------
// TestSuite model — IS the test run record (one row per execution). The run
// configuration (targetUrl / timeBudget / mutationRate) mirrors the engine
// inputs; the count fields are populated from the engine's report on
// completion. jobId links to the async Flask job for polling.
// ----------------------------------------------------------------------------
model TestSuite {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String?
  status    SuiteStatus @default(pending)
  jobId     String? // Flask async job id
  runType   TestRunType @default(generated)

  // Set only on a "replay" suite: points at the original AI-generated suite
  // whose RequestLog rows were resent verbatim. Always the true origin, never
  // an intermediate replay, so every replay in a chain resends the same fixed
  // baseline and stays directly comparable to its siblings.
  originSuiteId String?
  originSuite   TestSuite?  @relation("SuiteReplays", fields: [originSuiteId], references: [id], onDelete: Cascade)
  replays       TestSuite[] @relation("SuiteReplays")

  // Run configuration — passed to the engine
  targetUrl    String
  timeBudget   Int // engine time_duration, in seconds
  mutationRate Float  @default(0.2)
  // Extra HTTP headers layered onto every request made to the target API
  // (e.g. Authorization for Basic/Bearer/API-key auth). Write-only: never
  // selected back into read responses, since these are live credentials.
  customHeaders Json?
  // Endpoint IDs excluded from this run's spec before it's sent to the
  // engine — e.g. an operation known to be flaky/unsafe to fuzz. Not a real
  // FK (an Endpoint can be deleted later); run() looks them up defensively
  // and ignores any id that no longer resolves.
  excludedEndpointIds String[] @default([])

  // Results summary — filled from the engine report
  totalEndpoints   Int @default(0)
  coveredEndpoints Int @default(0)
  totalTestCases   Int @default(0)
  passedTestCases  Int @default(0)
  failedTestCases  Int @default(0)

  // Nullable so that deleting an account does not have to delete the run
  // history it left behind in other people's projects. Every existing row has
  // a value; only a deleted user produces a null here.
  triggeredById String?
  triggeredBy   User?   @relation("TriggeredSuites", fields: [triggeredById], references: [id], onDelete: SetNull)

  // Snapshot of the dependency graph as it stood for this run: the semantic
  // edges plus the Q-values the MARL loop put on them. Stored per-run rather
  // than read from the project, so the graph shown next to a run's results is
  // the one that produced them even after the spec moves on.
  dependencyGraph Json?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  testCases   TestCase[]
  requestLogs RequestLog[]

  @@index([projectId])
  @@map("test_suites")
}

// ----------------------------------------------------------------------------
// TestCase model — one request/response record produced during a run,
// derived from the engine's output JSON. Stores the request that was sent
// and the response received, plus an optional plain-language failure note.
// ----------------------------------------------------------------------------
model TestCase {
  id          String    @id @default(uuid())
  testSuiteId String
  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  endpointId  String
  endpoint    Endpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  requestBody    Json?
  requestHeaders Json?
  statusCode     Int?
  responseBody   Json?
  responseTimeMs Int?
  passed         Boolean @default(false)

  // LLM-generated plain-language explanation for failures (exciting req)
  failureExplanation String?

  createdAt DateTime @default(now())

  @@index([testSuiteId])
  @@index([endpointId])
  @@map("test_cases")
}

// ----------------------------------------------------------------------------
// RequestLog model — one captured request/response from the recording proxy.
// Unlike TestCase (a per-endpoint aggregate), this stores EVERY individual
// request the engine sent during a run, with the full request and response, so
// the user can inspect exactly what was sent and what came back. Endpoint is
// optional because a captured request may not map to a known spec path.
// ----------------------------------------------------------------------------
model RequestLog {
  id          String    @id @default(uuid())
  testSuiteId String
  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  endpointId  String?
  endpoint    Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  seq        Int // order the request was sent within the run
  method     String
  path       String // concrete path the engine hit, e.g. /users/42
  url        String // full forwarded URL
  statusCode Int?
  durationMs Int?

  requestHeaders    Json?
  requestBody       String?
  requestTruncated  Boolean @default(false)
  responseHeaders   Json?
  responseBody      String?
  responseTruncated Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([testSuiteId, endpointId])
  @@index([testSuiteId, statusCode])
  @@map("request_logs")
}
