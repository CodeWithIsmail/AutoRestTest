# Copy this file to `.env` and fill in real values.
# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/autoresttest

# Secret used to sign JWT access tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key

# HTTP port the NestJS server binds to
PORT=3000

# Allowed browser origin(s) for CORS (comma-separated). The Next.js frontend
# dev server runs on port 3001.
CORS_ORIGIN=http://localhost:3001

# Base URL of the Python engine-service that runs the testing engine.
# Use 127.0.0.1 (not localhost) to avoid Node fetch resolving to IPv6 ::1.
ENGINE_SERVICE_URL=http://127.0.0.1:5000

# Optional shared secret; if set it is sent as X-Service-Token to engine-service
# (must match the engine-service SERVICE_TOKEN).
ENGINE_SERVICE_TOKEN=

# ---- Accounts ----
# Whether signing up has to prove the address before an account is created.
# With this on, /auth/register parks the details in pending_signups and emails a
# code; the account appears only at /auth/verify-signup. That is what stops
# someone claiming an email they do not own.
# Set to false to skip the pending step entirely and create the account
# outright — the escape hatch for demos, and for hosts where mail cannot be
# delivered. Locally, prefer EMAIL_MODE=mock: it prints the code to the console.
REQUIRE_EMAIL_VERIFICATION=true

# Comma-separated allowlist of user emails allowed to open /admin/llm-settings
# (GET/PATCH /admin/llm-settings/*). No DB-backed admin role exists on
# purpose -- Role is project-scoped and this isn't -- so this is the whole
# gate. Leave empty to disable admin access entirely.
ADMIN_EMAILS=

# ---- LLM (plain-language failure explanations, Reports module) ----
# "mock" returns canned explanations offline (no key/cost); "real" calls the API.
# Secret, set once at deploy: never touch this after the app is up.
LLM_MODE=mock
# Provider API key (real mode only) -- the *fallback* default. An admin can
# set/replace/clear the real key live from /admin/llm-settings
# (REPORT_EXPLANATION scope) instead of editing this.
LLM_API_KEY=
# OpenAI-compatible model + base URL. Also just fallback defaults now -- same
# admin override applies to these.
LLM_ENGINE=google/gemini-2.5-flash-lite
LLM_API_BASE=https://openrouter.ai/api/v1

# ---- Email (Resend — invitations, welcome, run notifications) ----
# Resend is an HTTPS API rather than SMTP, so it also works on hosts that block
# outbound SMTP ports (Render's free tier, for one).
# "mock" logs the rendered email to the console and never calls out; "real" sends.
EMAIL_MODE=mock
# API key from https://resend.com/api-keys (real mode only).
RESEND_API_KEY=
# Sender. A verified domain is needed for real recipients — onboarding@resend.dev
# works for testing, but Resend will only deliver it to your own account email.
EMAIL_FROM=AutoRestTest <onboarding@resend.dev>
# Dev only: deliver every message to this address instead of the real recipient,
# who is shown in the subject. Lets you demo invites to any address.
EMAIL_DEV_REDIRECT_TO=
# Public origin of the Next.js app. Used to build the links inside emails.
APP_URL=http://localhost:3001
