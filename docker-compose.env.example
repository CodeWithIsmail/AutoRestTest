# ==========================================
# AutoRestTest - Docker Compose Config
# ==========================================
# This file provides the configuration for running the entire AutoRestTest platform locally.
# Rename this file to `.env` and run `docker-compose up -d --build`.

# 1. Admin Email (User with these emails will be the system admin and can update LLM API Settings)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# 2. Database Password 
POSTGRES_PASSWORD=securepassword123

# 3. Security Tokens (Auto-shared between backend and test engine)
SHARED_INTERNAL_TOKEN=autoresttest-super-secret-token
JWT_SECRET=super-secure-jwt-secret-replace-me-in-production

# 4. Email Settings
# If EMAIL_MODE=mock, emails are just printed to the backend console. 
# If EMAIL_MODE=real, provide a valid RESEND_API_KEY.
EMAIL_MODE=mock
RESEND_API_KEY=
EMAIL_FROM="AutoRestTest <noreply@example.com>"
