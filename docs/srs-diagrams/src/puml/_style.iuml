' Shared look-and-feel for all AutoRestTest use-case diagrams.
' Included right after @startuml in each diagram.
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam actorStyle awesome
skinparam ArrowColor #33475b
skinparam packageStyle rectangle

skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2B6CB0
  BorderThickness 1.3
  FontColor #14181F
  StereotypeFontColor #B7791F
}
skinparam actor {
  BackgroundColor #CFE3FF
  BorderColor #2B6CB0
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #9AA5B1
  FontStyle bold
  FontColor #33475b
}
