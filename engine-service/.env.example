# ---- engine-service configuration ----

# Absolute or relative path to the autoresttest-core project root.
# Defaults to ../autoresttest-core relative to this service.
CORE_DIR=../autoresttest-core

# Where per-job working directories are created.
JOBS_DIR=./jobs

# "mock"  -> do not run the real engine; emit canned outputs (fast, free, offline).
# "real"  -> shell out to the actual engine (needs a funded LLM key, takes minutes).
ENGINE_MODE=real

# Command used to launch the engine (run inside CORE_DIR). Overridable for venvs.
# Prefer the engine venv's interpreter over `poetry run`: poetry inserts three
# processes between this service and the engine, so a kill has to walk the tree.
# Find yours with `cd ../autoresttest-core && poetry env info --executable`.
# ENGINE_CMD=/path/to/venv/bin/python -m autoresttest.autoresttest
ENGINE_CMD=poetry run autoresttest

# LLM provider key handed to the engine (real mode only) -- the *fallback*
# default. The NestJS backend's admin settings page (/admin/llm-settings,
# TEST_ENGINE scope) can set/replace/clear the real key live, and it travels
# with each /runs request, overriding this for that run only. Leave this set
# as a safety net for when no admin key is stored, or for running
# engine-service standalone without the backend.
API_KEY=

# Defaults written into the per-run configurations.toml. The model must support
# JSON mode. Prefer a small, fast one: the engine only uses the LLM to fill
# schemas with plausible values, and that phase is not covered by a run's
# timeBudget, so latency here sets how long a cold run takes. A 70B was measured
# at 2-4 min/call against an 8B's ~9s on the same endpoint, for output of
# comparable usefulness. Verify any candidate actually populates its arrays --
# one model returned well-formed but empty JSON.
#
# These are only the *fallback* defaults now: the NestJS backend's admin
# settings page (/admin/llm-settings, TEST_ENGINE scope) can override the
# model/base URL/RPM limit/max tokens/temperatures per run with no restart of
# this service. An unset admin override falls straight through to whatever is
# configured here, exactly as before that page existed.
LLM_ENGINE=google/gemini-2.5-flash-lite
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_RPM_LIMIT=0

# Service-wide fallback Authorization header applied to engine requests when a
# run supplies none. If left empty, a non-empty JWT_TOKEN in autoresttest-core's
# own .env is used instead ("Bearer ${JWT_TOKEN}"). Temporary until the per-suite
# auth field exists.
TEST_AUTH_HEADER=

# Shared secret the NestJS backend must send as X-Service-Token. Empty = no auth.
SERVICE_TOKEN=

# HTTP port for this service.
PORT=5000

# Extra seconds allowed on top of a run's timeBudget before it is killed
# (covers the un-timed LLM value-generation phase).
JOB_TIMEOUT_BUFFER=1800

# Threads generating value tables. That phase is NOT covered by a run's
# timeBudget and costs two LLM calls per operation, so it dominates a cold run.
# Rate-limited free tiers cap *concurrent* requests, which LLM_RPM_LIMIT does not
# control -- NVIDIA NIM returned 429s and 500s at 8 workers. Raise only on a paid
# endpoint; a failed call costs an operation its value table.
ENGINE_VALUE_WORKERS=3

# Reuse the engine's cached dependency graph and Q-tables when the same spec is
# run again, skipping both un-timed phases. Set to false to force a cold run.
ENGINE_USE_CACHE=true

# Interpreter used to build a dependency graph without running a test
# (graph_worker.py, which imports autoresttest and so needs the engine's venv).
# Defaults to the first token of ENGINE_CMD, which is already correct in the
# recommended `<venv>/python -m autoresttest.autoresttest` form. Set it here only
# if ENGINE_CMD is a wrapper like `poetry run autoresttest`.
# ENGINE_PYTHON=/path/to/venv/bin/python

# Wall-clock ceiling for one graph build. Graph construction is embedding-based,
# not LLM-based -- seconds of work behind a one-off gensim model load -- so this
# is sized for a cold model load on a slow disk, not for the work itself.
GRAPH_TIMEOUT=900


# ---- OOPS spec generation (upload a codebase -> generate an OpenAPI spec) ----

# Path to the OOPS-final project root.
OOPS_DIR=../OOPS-final

# Interpreter used to run oops_worker.py. OOPS needs Python >= 3.12, so this is
# deliberately a different venv from autoresttest-core's. Defaults to
# <OOPS_DIR>/.venv/Scripts/python.exe on Windows, .venv/bin/python elsewhere.
OOPS_PYTHON=../OOPS-final/.venv/Scripts/python.exe

# Model used for every stage of the generation pipeline, via OOPS_API_KEY /
# OOPS_LLM_API_URL below (exported to the subprocess as LLM_API_KEY /
# LLM_API_URL). gemini-3.5-flash-lite via Gemini's OpenAI-compatible endpoint
# measures ~15-20 min end-to-end.
# Fallback default only -- the backend's admin settings page
# (/admin/llm-settings, SPEC_GENERATION scope) can override this and
# OOPS_RPM_LIMIT per request with no restart.
OOPS_MODEL=gemini-3.5-flash-lite

# Hard wall-clock ceiling for one generation (seconds). Sized with headroom
# over the ~15-20 min measured runtime.
OOPS_TIMEOUT=7200

# Requests per minute allowed across the whole generation pipeline. Gemini's
# free tier allows 15 rpm; kept just under it with headroom, matching
# OOPS-final/main.py's own sample. Raise only on a paid endpoint.
OOPS_RPM_LIMIT=12

# How many pipeline conversations run concurrently. Matches OOPS-final's own
# built-in default; lower it if you see 429s.
OOPS_BATCH_SEMAPHORE=16

# Upload guards for the source archive.
OOPS_MAX_ZIP_BYTES=52428800
OOPS_MAX_SOURCE_BYTES=209715200
OOPS_MAX_FILES=5000

# Dedicated LLM credentials for spec generation, independent of API_KEY /
# LLM_API_BASE above -- OOPS can run against a different provider (e.g.
# Gemini) than whatever the test-generation engine uses. Fallback defaults:
# the admin settings page (/admin/llm-settings, SPEC_GENERATION scope) can
# override the key and base URL live, same as TEST_ENGINE's API_KEY above.
OOPS_API_KEY=
OOPS_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
