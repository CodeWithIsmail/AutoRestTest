# ---- engine-service configuration ----

# Absolute or relative path to the autoresttest-core project root.
# Defaults to ../autoresttest-core relative to this service.
CORE_DIR=../autoresttest-core

# Where per-job working directories are created.
JOBS_DIR=./jobs

# "mock"  -> do not run the real engine; emit canned outputs (fast, free, offline).
# "real"  -> shell out to the actual engine (needs a funded LLM key, takes minutes).
ENGINE_MODE=real

# Command used to launch the engine (run inside CORE_DIR). Overridable for venvs.
# Prefer the engine venv's interpreter over `poetry run`: poetry inserts three
# processes between this service and the engine, so a kill has to walk the tree.
# Find yours with `cd ../autoresttest-core && poetry env info --executable`.
# ENGINE_CMD=/path/to/venv/bin/python -m autoresttest.autoresttest
ENGINE_CMD=poetry run autoresttest

# LLM provider key handed to the engine (real mode only).
API_KEY=

# Defaults written into the per-run configurations.toml. The model must support
# JSON mode. Prefer a small, fast one: the engine only uses the LLM to fill
# schemas with plausible values, and that phase is not covered by a run's
# timeBudget, so latency here sets how long a cold run takes. A 70B was measured
# at 2-4 min/call against an 8B's ~9s on the same endpoint, for output of
# comparable usefulness. Verify any candidate actually populates its arrays --
# one model returned well-formed but empty JSON.
LLM_ENGINE=google/gemini-2.5-flash-lite
LLM_API_BASE=https://openrouter.ai/api/v1

# Service-wide fallback Authorization header applied to engine requests when a
# run supplies none. If left empty, a non-empty JWT_TOKEN in autoresttest-core's
# own .env is used instead ("Bearer ${JWT_TOKEN}"). Temporary until the per-suite
# auth field exists.
TEST_AUTH_HEADER=

# Shared secret the NestJS backend must send as X-Service-Token. Empty = no auth.
SERVICE_TOKEN=

# HTTP port for this service.
PORT=5000

# Extra seconds allowed on top of a run's timeBudget before it is killed
# (covers the un-timed LLM value-generation phase).
JOB_TIMEOUT_BUFFER=1800

# Threads generating value tables. That phase is NOT covered by a run's
# timeBudget and costs two LLM calls per operation, so it dominates a cold run.
# Rate-limited free tiers cap *concurrent* requests, which LLM_RPM_LIMIT does not
# control -- NVIDIA NIM returned 429s and 500s at 8 workers. Raise only on a paid
# endpoint; a failed call costs an operation its value table.
ENGINE_VALUE_WORKERS=3

# Reuse the engine's cached dependency graph and Q-tables when the same spec is
# run again, skipping both un-timed phases. Set to false to force a cold run.
ENGINE_USE_CACHE=true


# ---- OOPS spec generation (upload a codebase -> generate an OpenAPI spec) ----

# Path to the OOPS-core project root.
OOPS_DIR=../OOPS-core

# Interpreter used to run oops_worker.py. OOPS needs Python >= 3.12, so this is
# deliberately a different venv from autoresttest-core's. Defaults to
# <OOPS_DIR>/.venv/Scripts/python.exe on Windows, .venv/bin/python elsewhere.
OOPS_PYTHON=../OOPS-core/.venv/Scripts/python.exe

# Model used for every stage of the generation pipeline. Reuses API_KEY and
# LLM_API_BASE above, exported to the subprocess as LLM_API_KEY / LLM_API_URL.
OOPS_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Hard wall-clock ceiling for one generation (seconds). Generation is LLM-bound
# and can legitimately run for hours on a mid-size backend.
OOPS_TIMEOUT=14400

# Requests per minute allowed across the whole generation pipeline. OOPS's own
# default is 120, which is ~3x the NVIDIA free tier (~35-40 rpm) and collapses
# into a 429 retry storm that kills the run. Raise only on a paid endpoint.
OOPS_RPM_LIMIT=35

# How many pipeline conversations run concurrently. OOPS's default of 3 is
# sized for its heaviest stage; lower it if you still see 429s.
OOPS_BATCH_SEMAPHORE=3

# Upload guards for the source archive.
OOPS_MAX_ZIP_BYTES=52428800
OOPS_MAX_SOURCE_BYTES=209715200
OOPS_MAX_FILES=5000
